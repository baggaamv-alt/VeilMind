# ---------------------------------------------------------------------------
# Veilmind — configuration
# Copy to .env and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# auto  = LIVE if HINDSIGHT_API_KEY is set, otherwise DEMO
# live  = force LIVE (falls back to DEMO with a warning if the key is missing)
# demo  = force DEMO (local deterministic simulation, no API calls)
APP_MODE=auto

# --- Hindsight Cloud (LIVE MODE memory) ---
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# prefix for every bank id this app creates (client banks, firm-playbook, leak-verifier)
HINDSIGHT_BANK_PREFIX=veilmind-
# true = retain in the background (faster seeding, memories appear a little later)
HINDSIGHT_RETAIN_ASYNC=false

# --- Groq (independent leak-check judge in LIVE MODE) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
LLM_MAX_RETRIES=3

# Leak-check layer-2 engine: auto | groq | hindsight
#   auto      = Groq if GROQ_API_KEY is set, else Hindsight reflect on the empty isolated leak-verifier bank
VERIFIER_ENGINE=auto

# --- App ---
DB_PATH=veilmind.sqlite3
# visual pacing of pipeline stages in DEMO MODE only (ms)
DEMO_STAGE_DELAY_MS=650
MIN_CORROBORATION_FOR_UNUSUAL=2
